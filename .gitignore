# Calibration recordings and generated model artifacts stay local. MANIFEST.yaml
# records logical dataset IDs, hashes, provenance and accepted metrics without
# putting large raw/model files in Git.
sdu_apex_autodrive/artifacts/calibration/raw/**
!sdu_apex_autodrive/artifacts/calibration/raw/
!sdu_apex_autodrive/artifacts/calibration/raw/.gitkeep
sdu_apex_autodrive/artifacts/calibration/derived/**
!sdu_apex_autodrive/artifacts/calibration/derived/
!sdu_apex_autodrive/artifacts/calibration/derived/**/
!sdu_apex_autodrive/artifacts/calibration/derived/**/metrics.csv
!sdu_apex_autodrive/artifacts/calibration/derived/**/wheel_speed_map.csv
!sdu_apex_autodrive/artifacts/calibration/MANIFEST.yaml
sdu_apex_autodrive/artifacts/calibration/derived/**/sensor_fusion_model*.hpp
