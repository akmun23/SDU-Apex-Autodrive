<?xml version="1.0"?>
<package format="3">
  <name>sdu_apex_autodrive</name>
  <version>0.3.0</version>
  <description>AutoDRIVE bridge and direct MPC actuator integration.</description>
  <maintainer email="akmun23@student.sdu.dk">Aksel Munksgaard-Ottosen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>sdu_apex_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>f1tenth_localization</exec_depend>
  <exec_depend>f1tenth_mpc</exec_depend>
  <exec_depend>f1tenth_planning</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <export><build_type>ament_python</build_type></export>
</package>
